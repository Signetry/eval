# The one recipe for the published pages.
#
# CI does not reimplement these commands. It runs these targets and then checks that the
# working tree is unchanged, so the page you regenerate locally is byte-for-byte the page
# CI expects. If CI kept its own copy of the commands, any drift between the two would
# surface as a stale-page failure that nobody could explain from the log — which is
# exactly what happened when the workflow's inline commands and the regeneration
# instructions printed on the page itself had quietly diverged.
#
# Publishing is a pull request, not a CI push. `main` is protected, and a governance
# product whose own numbers arrive by a bot bypassing branch protection is arguing
# against its own thesis. So CI verifies, humans admit, and the numbers reach `main` the
# same way every other change does.

PY ?= python
SIGNETRY_EVAL ?= signetry-eval

# Label the live row with the signetry-core that is actually installed — never a
# hardcoded version. pyproject pins it, so this is reproducible; bumping that pin without
# refreshing the pages is precisely the staleness `verify-leaderboard` exists to catch.
CORE_VERSION := $(shell $(PY) -c 'import signetry_core; print(signetry_core.__version__)' 2>/dev/null)

.PHONY: help leaderboard benchmark published-numbers \
        check-leaderboard check-benchmark \
        verify-leaderboard verify-benchmark verify-published-numbers test

# The verify targets are regenerate-then-diff. Keep them ordered.
.NOTPARALLEL:

help:
	@echo "make leaderboard              regenerate docs/LEADERBOARD.{md,json}"
	@echo "make benchmark               regenerate docs/BENCHMARK.{md,json}"
	@echo "make published-numbers       regenerate both"
	@echo "make verify-leaderboard      regenerate, then fail if the committed page is stale"
	@echo "make verify-benchmark        regenerate, then fail if the committed table is stale"
	@echo "make verify-published-numbers  fail if either is stale"
	@echo "make test                    run the test suite"

# Axis 2 needs signetry-core's SAST engine. The committed page includes axis 2, so
# regenerating without the engine would produce an axis-1-only page that diffs against
# the committed one and reads as "stale" when the real problem is the install. Fail with
# the actual reason instead.
leaderboard:
	@test -n "$(CORE_VERSION)" || { \
	  echo "cannot read signetry_core.__version__ — is signetry-core installed? (pip install -e '.[dev]')" >&2; \
	  exit 1; \
	}
	@$(PY) -c "from signetry_core import scan_repository" 2>/dev/null || { \
	  echo "installed signetry-core $(CORE_VERSION) lacks scan_repository; the detection axis cannot be regenerated" >&2; \
	  exit 1; \
	}
	@mkdir -p docs
	$(SIGNETRY_EVAL) leaderboard --with-detection --version "$(CORE_VERSION)" > docs/LEADERBOARD.md
	$(SIGNETRY_EVAL) leaderboard --with-detection --version "$(CORE_VERSION)" --json > docs/LEADERBOARD.json

benchmark:
	@$(PY) -c "from signetry_core import scan_repository" 2>/dev/null || { \
	  echo "installed signetry-core lacks scan_repository; refusing to emit a table for a scanner that did not run" >&2; \
	  exit 1; \
	}
	@mkdir -p docs
	{ \
	  echo '<!-- Generated by `make benchmark` — do not edit by hand; verified by .github/workflows/benchmark.yml. -->'; \
	  echo ""; \
	  $(SIGNETRY_EVAL) corpus --markdown; \
	} > docs/BENCHMARK.md
	$(SIGNETRY_EVAL) corpus --json > docs/BENCHMARK.json

published-numbers: leaderboard benchmark

# One target per owned file set, mirroring "one generator per file": the leaderboard
# workflow owns docs/LEADERBOARD.{md,json} and must not fail on a stale benchmark it does
# not generate.
#
# check-* is diff-only and assumes the regeneration already ran, so CI can regenerate
# once (and upload the artifact) and then check. verify-* is the one-shot for humans.
#
# Each checks that git tracks the page before diffing it: `git diff` says nothing about a
# file git is not tracking, so a page deleted from the repo and then regenerated would
# sail through the diff as "current" while not being published at all.
check-leaderboard:
	@git ls-files --error-unmatch docs/LEADERBOARD.md docs/LEADERBOARD.json >/dev/null 2>&1 || { \
	  echo "docs/LEADERBOARD.{md,json}: not tracked by git." >&2; \
	  echo "A generated page git does not track cannot be verified — commit it." >&2; \
	  exit 1; \
	}
	@git diff --exit-code -- docs/LEADERBOARD.md docs/LEADERBOARD.json || { \
	  echo "" >&2; \
	  echo "docs/LEADERBOARD.{md,json} are stale — the diff above is what regeneration produced." >&2; \
	  echo "Run 'make leaderboard', commit the result, and open a pull request." >&2; \
	  exit 1; \
	}

check-benchmark:
	@git ls-files --error-unmatch docs/BENCHMARK.md docs/BENCHMARK.json >/dev/null 2>&1 || { \
	  echo "docs/BENCHMARK.{md,json}: not tracked by git." >&2; \
	  echo "A generated table git does not track cannot be verified — commit it." >&2; \
	  exit 1; \
	}
	@git diff --exit-code -- docs/BENCHMARK.md docs/BENCHMARK.json || { \
	  echo "" >&2; \
	  echo "docs/BENCHMARK.{md,json} are stale — the diff above is what regeneration produced." >&2; \
	  echo "Run 'make benchmark', commit the result, and open a pull request." >&2; \
	  exit 1; \
	}

verify-leaderboard: leaderboard check-leaderboard

verify-benchmark: benchmark check-benchmark

verify-published-numbers: verify-leaderboard verify-benchmark

test:
	$(PY) -m pytest tests/ -q
